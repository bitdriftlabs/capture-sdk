        "2026-08-20/rustfmt-nightly-x86_64-unknown-linux-gnu.tar.gz": "71425c462fc527444a496fe68bb621b508559717b161506b4c52a964895c88c5",
    },
    urls = [
        # rust-analyzer's rules-rust setup reads only the first URL for rust-src.
        # It must therefore be the official mirror: the mobile release contains custom target stdlibs,
        # but no rust-src archive. The custom-stdlib checksums above make Bazel fall back to the
        # mobile release for those archives.
        "https://static.rust-lang.org/dist/{}.tar.gz",
        "https://github.com/bitdriftlabs/rust-std-mobile/releases/download/" + RUST_VERSION + "/{}.tar.gz",
    ],
    versions = [
        RUST_VERSION,
        "nightly/2025-10-02",
    ],
)

# BEGIN rust-std-tsan checksum. Generated by tools/rust_std_checksum.sh.
RUST_IOS_TSAN_STDLIB_SHA256 = "7da13f3f88026eda70dcdfbe0e2410972bea0f2fb9678be285310cc76b55e8bb"
# END rust-std-tsan checksum.

# rules_rs accepts only rust-std-<version>-<triple> archives. Fetch the separately
# instrumented sysroot ourselves, then select it only from the iOS TSan toolchain.
http_archive(
    name = "rust_std_tsan_aarch64_apple_ios_sim",
    build_file_content = """
load("@rules_rust//rust:toolchain.bzl", "rust_stdlib_filegroup")

rust_stdlib_filegroup(
    name = "rust_std",
    srcs = glob(
        [
            "rust-std-aarch64-apple-ios-sim/lib/rustlib/aarch64-apple-ios-sim/lib/*.rlib",
            "rust-std-aarch64-apple-ios-sim/lib/rustlib/aarch64-apple-ios-sim/lib/*.rmeta",
            "rust-std-aarch64-apple-ios-sim/lib/rustlib/aarch64-apple-ios-sim/lib/*.dylib*",
            "rust-std-aarch64-apple-ios-sim/lib/rustlib/aarch64-apple-ios-sim/lib/*.a",
            "rust-std-aarch64-apple-ios-sim/lib/rustlib/aarch64-apple-ios-sim/lib/self-contained/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
""",
    sha256 = RUST_IOS_TSAN_STDLIB_SHA256,
    strip_prefix = "rust-std-tsan-" + RUST_VERSION + "-aarch64-apple-ios-sim",
    urls = [
        "https://github.com/bitdriftlabs/rust-std-mobile/releases/download/" + RUST_VERSION +
        "/rust-std-tsan-" + RUST_VERSION + "-aarch64-apple-ios-sim.tar.gz",
    ],
)

use_repo(
    rust,
    "rust_macos_aarch64__aarch64-apple-ios-sim__stable_tools",
    "rust_toolchains",
)

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-apple-ios-sim",
        "aarch64-apple-ios",
        "aarch64-linux-android",
        "armv7-linux-androideabi",
        "i686-linux-android",
        "x86_64-apple-darwin",
        "x86_64-apple-ios",
        "x86_64-linux-android",
        "x86_64-unknown-linux-gnu",
    ],
    # Preserve the existing custom rules_rust toolchain while migrating dependency resolution.
    use_legacy_rules_rust_platforms = True,
)
crate.annotation(
    crate = "anyhow",
    patch_args = ["-p1"],
    patches = ["//bazel/third_party:anyhow_optional_backtrace.patch"],
    rustc_flags = ["--check-cfg=cfg(anyhow_no_backtrace)"],
)

# libc 0.2.190 made its dyld declarations macOS-only; backtrace also uses them on iOS.
# Remove this patch when upstream backtrace declares its own Apple dyld FFI.
crate.annotation(
    crate = "backtrace",
    patch_args = ["-p1"],
    patches = ["//bazel/third_party:backtrace_apple_dyld.patch"],
)

# File generation must be skipped because of https://github.com/bazelbuild/rules_rust/issues/3552
crate.annotation(
    build_script_env = {"SKIP_PROTO_GEN": "1"},
    crate = "bd-grpc",
)
crate.annotation(
    build_script_env = {"SKIP_PROTO_GEN": "1"},
    crate = "bd-pgv",
)
crate.annotation(
    build_script_env = {"SKIP_PROTO_GEN": "1"},
    crate = "bd-proto",
)
crate.annotation(
    build_script_env = {"SKIP_FILE_GEN": "1"},
    crate = "bd-report-writer",
)
crate.annotation(
    build_script_env = {"SKIP_FILE_GEN": "1"},
    crate = "bd-bonjson-ffi",
)

# A recent rustix update seems to have broken something here, so manually add in the crates we need to build under Bazel.
crate.annotation(
    crate = "linux-raw-sys",
    crate_features = [
        "errno",
        "std",
        "general",
        "ioctl",
    ],
)

# Android's NDK and Apple's SDK provide zlib dynamically. Keep libz-sys's build script enabled
# so those targets emit their platform-native `-lz` directive. On Linux, enable libz-sys's
# `static` feature so its build script compiles the crate's bundled zlib through Bazel's
# hermetic C/C++ toolchain instead of probing the host system.
crate.annotation(
    crate = "libz-sys",
    gen_build_script = "on",
)
crate.annotation_select(
    crate = "libz-sys",
    crate_features = ["static"],
    triples = ["x86_64-unknown-linux-gnu"],
)
use_repo(crate, "crates")
