    # rust-std-mobile is compiled with immediate-abort. Keep the Rust compiler flags on only
    # the toolchains that link that custom std; host and exec toolchains use the stable defaults.
    extra_rustc_flags_triples = {
        target_triple: MOBILE_IMMEDIATE_ABORT_RUSTC_FLAGS
        for target_triple in MOBILE_RUST_TARGET_TRIPLES
    },
    extra_target_triples = [
        target_triple
        for target_triple in MOBILE_RUST_TARGET_TRIPLES
    ],
    rustfmt_version = "nightly/2026-08-12",
    # We need this shas, since these archives are generated by us and we want to make sure we always use these as opposed
    # to the official ones. There is a `rust_std_checksum.sh` script that generates these shas in the `tools` directory.
    # For security reasons, we include all shas here to make sure that a malicious actor with access to rust-std-mobile
    # can't include a compromised tool.
    #
    # Run ./tools/rust_std_checksum.sh <rust version> after rust-std-mobile
    # publishes that version. It updates RUST_VERSION and these regular/TSan
    # checksums together.
    sha256s = {
        # BEGIN rust-std checksums. Generated by tools/rust_std_checksum.sh.
        "rust-std-" + RUST_VERSION + "-aarch64-apple-ios-sim.tar.gz": "544c7e30d2d74f86d185e017bb7537c1dd3d264393223ee2ff59c1e0c32ba65b",
