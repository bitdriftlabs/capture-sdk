# END rust-std-tsan checksum.

# rules_rs accepts only rust-std-<version>-<triple> archives. Fetch the separately
# instrumented sysroot ourselves, then select it only from the iOS TSan toolchain.
http_archive(
    name = "rust_std_tsan_aarch64_apple_ios_sim",
    build_file_content = """
load("@rules_rust//rust:toolchain.bzl", "rust_stdlib_filegroup")

rust_stdlib_filegroup(
    name = "rust_std",
    srcs = glob(
        [
            "rust-std-aarch64-apple-ios-sim/lib/rustlib/aarch64-apple-ios-sim/lib/*.rlib",
            "rust-std-aarch64-apple-ios-sim/lib/rustlib/aarch64-apple-ios-sim/lib/*.rmeta",
            "rust-std-aarch64-apple-ios-sim/lib/rustlib/aarch64-apple-ios-sim/lib/*.dylib*",
            "rust-std-aarch64-apple-ios-sim/lib/rustlib/aarch64-apple-ios-sim/lib/*.a",
            "rust-std-aarch64-apple-ios-sim/lib/rustlib/aarch64-apple-ios-sim/lib/self-contained/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
""",
    sha256 = RUST_IOS_TSAN_STDLIB_SHA256,
    strip_prefix = "rust-std-tsan-" + RUST_VERSION + "-aarch64-apple-ios-sim",
    urls = [
        "https://github.com/bitdriftlabs/rust-std-mobile/releases/download/" + RUST_VERSION +
        "/rust-std-tsan-" + RUST_VERSION + "-aarch64-apple-ios-sim.tar.gz",
    ],
)

