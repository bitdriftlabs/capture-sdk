        "rust-std-" + RUST_VERSION + "-aarch64-linux-android.tar.gz": "dae0ba9f7c161ec8f0db3a78061e6cca7b267a3824a783621571a15e6a702acb",
        "rust-std-" + RUST_VERSION + "-armv7-linux-androideabi.tar.gz": "9aa77ced610cdf130918bc78d34dba67fe397e7629509370e4958b0fc4986e4e",
        "rust-std-" + RUST_VERSION + "-i686-linux-android.tar.gz": "a029535a93190df5dc497d55c96f67b46a1449d08553c2facef61254a9fc67e6",
        "rust-std-" + RUST_VERSION + "-x86_64-linux-android.tar.gz": "2d3a7c930321d96adb363e41c65cbcb0cfd530b557816d6e7f26e1c0d4d303b4",
        "rust-std-tsan-" + RUST_VERSION + "-aarch64-apple-ios-sim.tar.gz": "45698a30ca3c89bd1454df8ef7a8360f9de194b720af55af55b6baa3327d7331",
        "rustc-" + RUST_VERSION + "-aarch64-apple-darwin.tar.gz": "b7999e81c1ff2e900e6ba0ecc2ee740654963fd6a26cd7a69b81fd9bdd68a86e",
        "cargo-" + RUST_VERSION + "-aarch64-apple-darwin.tar.gz": "4c70846fd611a3e390ef149fe757402188f2029010285728bd0b4c53586c3c39",
