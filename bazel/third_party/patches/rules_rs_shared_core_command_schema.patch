 # Bazel 8 does not define attr.label_list_dict.
 _label_list_dict = getattr(attr, "label_list_dict", attr.string_list_dict)
 
+def expose_shared_core_command_schema(rctx, additive_build_file, source_root, output_dir):
+    """Materializes the schema inputs requested by the bd-proto BUILD annotation."""
+    if not additive_build_file or additive_build_file.name != "shared_core_command_schema.BUILD":
+        return
+
+    # Keep the import tree narrow so unrelated shared-core edits do not affect code generation.
+    for proto, directory in [
+        ("bitdrift_public/protobuf/logging/v1/payload.proto", "api/src"),
+        ("bitdrift_public/protobuf/workflow/v1/workflow_command.proto", "api/src"),
+        ("validate/validate.proto", "api/protoc-gen-validate"),
+    ]:
+        source = "{}/{}/{}".format(source_root, directory, proto)
+        # read watches local files outside the generated repository for edits.
+        rctx.file(output_dir + "/" + proto, rctx.read(source), executable = False)
+
 def spoke_repo_name(hub_name, name, version):
     return ("%s__%s-%s" % (hub_name, name, version)).replace("+", "-")
 
