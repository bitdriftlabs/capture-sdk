<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark only: identical to the default theme. -->
    <style name="Theme.MyApplication" parent="Theme.Material3.Dark">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/bitdrift_primary</item>
        <item name="colorPrimaryVariant">@color/bitdrift_primary_dark</item>
        <item name="colorOnPrimary">@color/bitdrift_background</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/bitdrift_text_secondary</item>
        <item name="colorSecondaryVariant">@color/bitdrift_text_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Background colors -->
        <item name="android:colorBackground">@color/bitdrift_background</item>
        <item name="colorSurface">@color/bitdrift_background_paper</item>
        <item name="colorOnSurface">@color/bitdrift_text_primary</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bitdrift_background</item>
        <!-- Customize your theme here. -->
        <item name="dividerColor">@color/bitdrift_border</item>
        <item name="preferenceTheme">@style/Bd.PreferenceThemeOverlay</item>
        <item name="android:itemTextAppearance">@style/SettingsMenuStyle</item>
    </style>

    <style name="SettingsMenuStyle">
        <item name="android:textColor">@color/bitdrift_text_primary</item>
    </style>
</resources>
