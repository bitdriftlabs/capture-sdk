load("//bazel:bitdrift_build_system.bzl", "bitdrift_rust_library")
load(":host_jvm_jni_test.bzl", "host_jvm_jni_test")

bitdrift_rust_library(
    name = "capture_core",
    test_name = "capture_core_host_jvm_jni_rust_test",
    test_tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "//platform/shared:platform-shared",
    ],
    alwayslink = True,
)

# HotSpot emits -Xcheck:jni diagnostics to the native process output. This test resolves its JDK
# through Bazel's Java runtime toolchain, then preserves the output and fails on any diagnostic.
host_jvm_jni_test(
    name = "capture_core_host_jvm_jni_test",
    test_binary = ":capture_core_host_jvm_jni_rust_test",
    wrapper_template = "jni_warnings_test.sh",
)

# Concatenate the proguard files from the capture and replay libraries
genrule(
    name = "proguard",
    srcs = [
        "//platform/jvm/capture:consumer-rules.pro",
        "//platform/jvm/replay:consumer-rules.pro",
    ],
    outs = ["proguard.txt"],
    cmd = "cat $(SRCS) > $@",
    visibility = ["//visibility:public"],
)
